  USERS {
    guid Id PK
    string PhoneNumber
    string Email
    string PasswordHash
    string DisplayName
    string AvatarUrl
    bool IsOnline
    datetime LastSeen
    datetime CreatedAt
  }
  FRIENDSHIPS {
    guid Id PK
    guid RequesterId FK
    guid AddresseeId FK
    guid PairUserLowId
    guid PairUserHighId
    enum Status "Pending, Accepted, Declined"
    datetime CreatedAt
    datetime UpdatedAt
  }
  USER_BLOCKS {
    guid BlockerId PK
    guid BlockedUserId PK
    datetime CreatedAt
  }
  CONVERSATIONS {
    guid Id PK
    string Name
    string AvatarUrl
    bool IsGroup
    guid CreatedById FK
    datetime CreatedAt
  }
  CONVERSATION_MEMBERS {
    guid ConversationId PK
    guid UserId PK
    enum Role "Member, Admin"
    datetime JoinedAt
    datetime LastReadAt
  }
  MESSAGES {
    guid Id PK
    guid ConversationId FK
    guid SenderId FK
    string Content
    enum Type "Text, Image, File, Call"
    guid ReplyToMessageId FK
    bool IsPinned
    datetime PinnedAt
    bool IsDeleted
    datetime CreatedAt
  }
  MESSAGE_RECEIPTS {
    guid MessageId PK
    guid UserId PK
    datetime DeliveredAt
  }
  MESSAGE_REACTIONS {
    guid MessageId PK
    guid UserId PK
    string Emoji
    datetime CreatedAt
  }
  MESSAGE_MENTIONS {
    guid MessageId PK
    guid UserId PK
  }
  MEDIA_ASSETS {
    guid Id PK
    guid ConversationId FK
    guid UploadedById FK
    string ObjectKey
    string FileName
    string ContentType
    enum Kind
    long Size
    datetime CreatedAt
  }
  PASSWORD_RESET_OTPS {
    guid Id PK
    guid UserId FK
    string CodeHash
    datetime ExpiresAt
    datetime ConsumedAt
    int FailedAttempts
  }
  PASSWORD_RESET_GRANTS {
    string TokenId PK
    guid UserId FK
    datetime ExpiresAt
    datetime ConsumedAt
  }
