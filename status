[32m+[m[32m### Cấu hình bí mật (KHÔNG commit lên git)[m
[32m+[m[32mCác giá trị bí mật đặt bằng **User Secrets** (máy dev) hoặc **biến môi trường** (server/CI), không để trong `appsettings.json`.[m
 [m
 ```bash[m
[31m-git clone https://github.com/hbachfs/Connext.git[m
[31m-cd Connext[m
[31m-git checkout develop[m
[31m-# Các bước tiếp theo: cập nhật sau[m
[32m+[m[32mcd <thư mục chứa Connext.Api.csproj>[m
[32m+[m[32mdotnet user-secrets set "ConnectionStrings:DefaultConnection" "<chuỗi kết nối SQL Server>"[m
[32m+[m[32mdotnet user-secrets set "Jwt:Key" "<chuỗi ngẫu nhiên >= 32 ký tự>"[m
[32m+[m[32mdotnet user-secrets set "Jwt:Issuer" "connext"[m
[32m+[m[32mdotnet user-secrets set "Jwt:Audience" "connext-clients"[m
[32m+[m[32mdotnet user-secrets set "Jwt:ExpireMinutes" "60"[m
[32m+[m[32mdotnet user-secrets set "Smtp:Host" "smtp.gmail.com"[m
[32m+[m[32mdotnet user-secrets set "Smtp:Port" "587"[m
[32m+[m[32mdotnet user-secrets set "Smtp:User" "<email gửi>"[m
[32m+[m[32mdotnet user-secrets set "Smtp:Password" "<App Password>"[m
[32m+[m[32mdotnet user-secrets set "Smtp:From" "<email gửi>"[m
[32m+[m[32mdotnet user-secrets set "Smtp:FromName" "Connext"[m
 ```[m
[32m+[m[32mTạo chuỗi ngẫu nhiên: `openssl rand -base64 48`.[m
[32m+[m[32mBiến môi trường tương ứng: đổi `:` thành `__` (vd `Jwt__Key`, `Smtp__Password`).[m
[32m+[m[32m`Jwt:Key` ngắn hơn 32 byte thì app không khởi động.[m
