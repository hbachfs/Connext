{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "Bucket": "connext-private",
    "UseSSL": false
  },
  "JwtSettings": {
    "Issuer": "ConnextApi",
    "Audience": "ConnextWeb",
    "ExpiryMinutes": 1440
  }
}
