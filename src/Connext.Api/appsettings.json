{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ConnextDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Key": "connext-development-jwt-key-change-this-2025-strong",
    "Issuer": "connext",
    "Audience": "connext-clients",
    "ExpireMinutes": 60,
    "ResetExpireMinutes": 10
  },
  "JwtSettings": {
    "Issuer": "ConnextApi",
    "Audience": "ConnextWeb",
    "ExpiryMinutes": 1440
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  },
  "Upload": {
    "MaxFileSizeMB": 5
  },
  "Ice": {
    "StunUrls": [ "stun:stun.l.google.com:19302" ]
  },
  "Calls": {
    "RingSeconds": 30
  }
}